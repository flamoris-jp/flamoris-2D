<Application x:Class="Flamoris.Flamoris2D.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.ja-JP.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ChromeBrush" Color="#F5F2F0" />
            <SolidColorBrush x:Key="PanelBrush" Color="#292B2F" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#41444A" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#1E2024" />
            <SolidColorBrush x:Key="AccentBrush" Color="#D20B3A" />
            <SolidColorBrush x:Key="PanelTextBrush" Color="#ECECEC" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
