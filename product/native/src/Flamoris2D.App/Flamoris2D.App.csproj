<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Flamoris.Flamoris2D.App</RootNamespace>
    <AssemblyName>Flamoris2D</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>FLAMORIS 2D</Product>
    <Description>Native FLAMORIS 2D production editor candidate.</Description>
    <VersionPrefix>0.4.0</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Flamoris.Mcp.Core" Version="1.1.0" GeneratePathProperty="true" />
    <None Include="$(PkgFlamoris_Mcp_Core)/assets/runtime/chipsy-activity.webp" Link="mcp-assets/chipsy-activity.webp" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\Flamoris2D.Rendering\Flamoris2D.Rendering.csproj" />
    <ProjectReference Include="..\Flamoris2D.ProductHost.Client\Flamoris2D.ProductHost.Client.csproj" />
  </ItemGroup>
  <Import Project="..\..\ProductHost.files.props" />
  <ItemGroup>
    <None Include="..\..\..\package.json"
          Link="package.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\node_modules\ag-psd\dist\**\*.js"
          Link="node_modules\ag-psd\dist\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\node_modules\ag-psd\package.json;..\..\..\node_modules\ag-psd\LICENSE" Link="node_modules\ag-psd\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\node_modules\base64-js\**\*" Link="node_modules\base64-js\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\node_modules\pako\**\*" Link="node_modules\pako\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
