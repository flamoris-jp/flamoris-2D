<Window x:Class="Flamoris.Flamoris2D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flamoris.Flamoris2D.App"
        Title="{DynamicResource App.Title}"
        Width="1440" Height="900" MinWidth="1060" MinHeight="680"
        Background="{StaticResource CanvasBrush}"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="9,3" />
        </Style>
        <Style x:Key="WorkflowButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="2,4" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="#FAF8F7" />
            <Setter Property="BorderBrush" Value="#C8C3C0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D20B3A" />
                    <Setter Property="Background" Value="#FFF0F3" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#D20B3A" />
                    <Setter Property="BorderBrush" Value="#A3092D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,7" />
        </Style>
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="8,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#28292B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F3" />
                    <Setter Property="BorderBrush" Value="#D6A6B2" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE4EA" />
                    <Setter Property="BorderBrush" Value="#D20B3A" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ContentControl x:Name="RecoveryCard" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="#FFF3D8" />
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.New}" InputGestureText="Ctrl+N"
                          Click="NewDocument_Click" />
                <Separator />
                <MenuItem Header="素材を読み込む（PSD / Cutwork）…" Click="ImportSource_Click" />
                <MenuItem Header="開く…" InputGestureText="Ctrl+O" Click="OpenDocument_Click" />
                <Separator />
                <MenuItem x:Name="SaveMenuItem" Header="{DynamicResource Menu.Save}"
                          InputGestureText="Ctrl+S" IsEnabled="False" Click="SaveDocument_Click" />
                <MenuItem Header="名前を付けて保存…" Click="SaveAsDocument_Click" />
                <MenuItem Header="コピーを保存…" Click="SaveCopyDocument_Click" />
                <MenuItem Header="別バージョンを保存…" Click="SaveIncrementalDocument_Click" />
                <MenuItem Header="復元…" Click="Recovery_Click" />
                <MenuItem Header="開発用"><MenuItem Header="PNG Mesh proof（保存不可）…" Click="LoadArtwork_Click" /></MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Exit}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Edit}">
                <MenuItem x:Name="UndoMenuItem" Header="{DynamicResource Menu.Undo}"
                          InputGestureText="Ctrl+Z" Click="Undo_Click" IsEnabled="False" />
                <MenuItem x:Name="RedoMenuItem" Header="{DynamicResource Menu.Redo}"
                          InputGestureText="Ctrl+Y" Click="Redo_Click" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.View}">
                <MenuItem Header="{DynamicResource Menu.FocusViewport}"
                          InputGestureText="Esc" Click="FocusViewport_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.About}" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}"
                BorderBrush="#D8D3D0" BorderThickness="0,0,0,1">
            <StackPanel>
                <ToolBarTray IsLocked="True" Background="{StaticResource ChromeBrush}">
                    <ToolBar Background="{StaticResource ChromeBrush}">
                        <Button Style="{StaticResource CommandButton}" Content="新規"
                                Click="NewDocument_Click" />
                        <Button Style="{StaticResource CommandButton}" Content="素材を読み込む…"
                                Click="ImportSource_Click" ToolTip="PSDまたはCutwork素材を読み込みます。" />
                        <Button x:Name="CancelArtworkButton" Content="中止" Click="CancelMeshWork_Click" Visibility="Collapsed" />
                        <Button x:Name="RefreshButton" Style="{StaticResource CommandButton}"
                                Content="状態を更新" Click="Refresh_Click" IsEnabled="False" />
                        <Separator />
                        <Button x:Name="UndoButton" Style="{StaticResource CommandButton}"
                                Content="元に戻す" Click="Undo_Click" IsEnabled="False" />
                        <Button x:Name="RedoButton" Style="{StaticResource CommandButton}"
                                Content="やり直し" Click="Redo_Click" IsEnabled="False" />
                        <Separator />
                        <TextBlock VerticalAlignment="Center" Margin="7,0,3,0"
                                   Foreground="#555" Text="Product Host" />
                        <Ellipse x:Name="HostStatusIndicator" Width="9" Height="9"
                                 Fill="#9A9A9A" Margin="4,0" />
                        <TextBlock x:Name="HostStatusText" VerticalAlignment="Center"
                                   Text="接続中…" Margin="2,0,8,0" />
                    </ToolBar>
                </ToolBarTray>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,0">
                        <ToggleButton x:Name="SourceContextButton" Tag="Source"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="素材" HorizontalAlignment="Center" />
                                <TextBlock Text="Source" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="MeshContextButton" Tag="Mesh"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="メッシュ" HorizontalAlignment="Center" />
                                <TextBlock Text="Mesh" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="RigContextButton" Tag="Rig"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="リグ" HorizontalAlignment="Center" />
                                <TextBlock Text="Rig" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="DeformContextButton" Tag="Deform"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="変形" HorizontalAlignment="Center" />
                                <TextBlock Text="Deform" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="AnimationContextButton" Tag="Animation"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="動き" HorizontalAlignment="Center" />
                                <TextBlock Text="Animation" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="PreviewContextButton" Tag="Preview"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="プレビュー" HorizontalAlignment="Center" />
                                <TextBlock Text="Preview" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ExportContextButton" Tag="Export"
                                      Style="{StaticResource WorkflowButton}"
                                      Click="WorkflowContext_Click">
                            <StackPanel>
                                <TextBlock Text="書き出し" HorizontalAlignment="Center" />
                                <TextBlock Text="Export" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>

                <Border Background="#E8E4E1" Padding="10,6">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" CornerRadius="3" Background="#D20B3A"
                                Padding="8,3" Margin="0,0,12,0">
                            <TextBlock x:Name="ActiveContextBadge" Foreground="White"
                                       FontWeight="SemiBold" Text="素材 / Source" />
                        </Border>
                        <TextBlock x:Name="ActiveToolSettingsText" VerticalAlignment="Center"
                                   Text="選択 — 素材または配置対象を選択" />
                    </DockPanel>
                </Border>
                <WrapPanel Margin="8,4">
                    <TextBlock Text="表示する状態" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="RenderOwnerList" MinWidth="220" MaxWidth="420" DisplayMemberPath="Label" SelectionChanged="RenderOwner_Changed" />
                    <TextBlock x:Name="RenderStatusText" Margin="12,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel x:Name="RigContextOptions" Margin="8,4" Visibility="Collapsed">
                    <Button Content="Bone / 骨" Tag="Bone" Click="RigContext_Click" Padding="10,5" Margin="3" />
                    <Button Content="Warp / 格子" Tag="Warp" Click="RigContext_Click" Padding="10,5" Margin="3" />
                    <Button Content="Weight / ウェイト" Tag="Weight" Click="RigContext_Click" Padding="10,5" Margin="3" />
                </WrapPanel>
                <StackPanel x:Name="MeshOptions" Visibility="Collapsed" Background="#EEEAE7">
                    <WrapPanel Margin="8,4">
                        <ToggleButton x:Name="StructureButton" Content="構造 / Structure" IsChecked="True"
                                      Tag="structure" Click="MeshContext_Click" Padding="8,4" Margin="2" />
                        <ToggleButton x:Name="LayoutButton" Content="位置決め / Layout" Tag="layout"
                                      Click="MeshContext_Click" Padding="8,4" Margin="2" />
                        <TextBlock Text="素材状態 / メッシュ" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <ComboBox x:Name="MeshKeyformList" MinWidth="150" MaxWidth="260"
                                  DisplayMemberPath="Label" SelectionChanged="MeshKeyform_Changed" />
                        <CheckBox x:Name="MeshOverlayCheck" Content="メッシュ表示" IsChecked="True" Margin="8,5"
                                  Click="MeshDisplay_Changed" />
                        <CheckBox x:Name="MeshContrastCheck" Content="高コントラスト" IsChecked="True" Margin="4,5"
                                  Click="MeshDisplay_Changed" />
                        <CheckBox x:Name="MeshIdsCheck" Content="頂点ID" Margin="4,5" Click="MeshDisplay_Changed" />
                        <CheckBox x:Name="MeshSnapCheck" Content="1px単位" Margin="4,5" Click="MeshDisplay_Changed" />
                        <Button Content="全体表示" Click="FitArtwork_Click" Padding="6,3" Margin="4,0" />
                        <Button Content="全頂点を選択" Click="SelectAllVertices_Click" Padding="6,3" Margin="4,0" />
                        <Button x:Name="MeshActionButton" Content="選択した頂点で面を作成" Click="MeshAction_Click"
                                Padding="6,3" Margin="4,0" Visibility="Collapsed" />
                    </WrapPanel>
                    <WrapPanel x:Name="GenerateOptions" Visibility="Collapsed" Margin="10,3,10,6">
                        <TextBlock Text="Grid 横 / 縦" VerticalAlignment="Center" />
                        <TextBox x:Name="GridColumns" Text="4" Width="35" Margin="4,0" TextChanged="MeshGenerationSettings_Changed" />
                        <TextBox x:Name="GridRows" Text="4" Width="35" Margin="4,0" TextChanged="MeshGenerationSettings_Changed" />
                        <Button Content="Gridを試す" Click="GridPreview_Click" Padding="6,3" />
                        <TextBlock Text="輪郭 α / 密度 / 角 / 内側" VerticalAlignment="Center" Margin="10,0,4,0" />
                        <TextBox x:Name="ContourAlpha" Text="0.1" Width="38" TextChanged="MeshGenerationSettings_Changed" />
                        <TextBox x:Name="ContourDensity" Text="0.45" Width="38" Margin="3,0" TextChanged="MeshGenerationSettings_Changed" />
                        <TextBox x:Name="ContourCorner" Text="0.65" Width="38" Margin="3,0" TextChanged="MeshGenerationSettings_Changed" />
                        <TextBox x:Name="ContourInterior" Text="0.3" Width="38" Margin="3,0" TextChanged="MeshGenerationSettings_Changed" />
                        <Button Content="輪郭から試す" Click="ContourPreview_Click" Padding="6,3" />
                        <Button x:Name="ApplyGeneratedButton" Content="プレビューを適用" IsEnabled="False"
                                Click="ApplyGenerated_Click" Padding="6,3" Margin="8,0" />
                        <Button Content="取消" Click="CancelGenerated_Click" Padding="6,3" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="RecoveryBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#4A251A" BorderBrush="#F09A65" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Product Hostを再起動"
                        Padding="10,4" Click="Reconnect_Click" />
                <TextBlock x:Name="RecoveryMessage" Foreground="#FFF3EC"
                           VerticalAlignment="Center"
                           Text="Product Hostとの接続を失いました。staleな表示を破棄し、保存と編集を停止しました。" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#292B2F" Padding="10,5">
            <DockPanel>
                <TextBlock x:Name="RevisionText" DockPanel.Dock="Right"
                           Foreground="#C7C9CD" Text="revision —" />
                <TextBlock x:Name="StatusText" Foreground="#ECECEC" Text="起動しています…" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="TimeSurfaceRow" Height="0" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Background="{StaticResource ChromeBrush}"
                    BorderBrush="#D8D3D0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Panel.Tools}"
                               Foreground="#333" FontWeight="SemiBold" Margin="9,8" />
                    <ListBox x:Name="ToolList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RailItem}"
                             SelectionChanged="ToolList_SelectionChanged" />
                </DockPanel>
            </Border>

            <Border x:Name="ViewportHost" Grid.Column="1" Background="{StaticResource CanvasBrush}"
                    BorderBrush="#111216" BorderThickness="1" Focusable="True"
                    FocusVisualStyle="{x:Null}">
                <Grid>
                    <local:MeshViewport x:Name="MeshCanvas" />
                    <StackPanel IsHitTestVisible="False" VerticalAlignment="Bottom" Background="#CC202124" Margin="4">
                        <TextBlock x:Name="ViewportContextText" Foreground="White" Text="素材 / Source" Margin="6,2" />
                        <TextBlock x:Name="ClickMeaningText" Foreground="#C7C9CD" Text="PNGでMesh体験を開始" Margin="6,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" />
                    <RowDefinition Height="0.95*" />
                </Grid.RowDefinitions>
                <Border Margin="8,8,8,4" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"
                                   Text="{DynamicResource Panel.Targets}" />
                        <ListBox x:Name="TargetList" Margin="6,0,6,6"
                                 Background="#202124" Foreground="{StaticResource PanelTextBrush}"
                                 BorderBrush="#41444A" SelectionChanged="TargetList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding VisibilityText, Mode=OneWay}"
                                                    Focusable="False" Padding="3,2" Margin="2,0"
                                                    ToolTip="表示だけを切り替えます。選択対象は変えません。"
                                                    Click="TargetVisibility_Click" />
                                            <Button Content="{Binding LockText, Mode=OneWay}"
                                                    Focusable="False" Padding="3,2" Margin="2,0"
                                                    ToolTip="ロックだけを切り替えます。選択対象は変えません。"
                                                    Click="TargetLocked_Click" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding IndentedName}" />
                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                       Foreground="#AEB0B5" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Margin="8,4,8,8"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"
                                   Text="{DynamicResource Panel.Properties}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,2">
                            <TextBlock Text="選択対象" Foreground="#AEB0B5" />
                            <TextBlock x:Name="SelectedTargetText" Text="—"
                                       Foreground="White" FontWeight="SemiBold" Margin="0,2,0,12" />
                            <TextBlock Text="表示名" Foreground="#AEB0B5" />
                            <TextBox x:Name="DisplayNameEditor" Margin="0,4,0,7"
                                     IsEnabled="False" />
                            <CheckBox x:Name="TargetVisibleEditor" Content="表示する" Foreground="White"
                                      IsEnabled="False" Margin="0,3" />
                            <CheckBox x:Name="TargetLockedEditor" Content="ロックする" Foreground="White"
                                      IsEnabled="False" Margin="0,3,0,9" />
                            <Button x:Name="ApplyNameButton" Content="変更を確定"
                                    HorizontalAlignment="Left" Padding="9,4"
                                    IsEnabled="False" Click="ApplyName_Click" />
                            <TextBlock Margin="0,16,0,0" Foreground="#8F9298"
                                       TextWrapping="Wrap"
                                       Text="表示とロックは選択とは別です。確定した変更は、まとめて1回で元に戻せます。" />
                            <StackPanel x:Name="AuthoringPanel" Visibility="Collapsed" Margin="0,12,0,0" />
                            <StackPanel x:Name="MeshPropertiesPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock x:Name="MeshPropertiesText" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="選択した頂点の意味ラベル" Foreground="#AEB0B5" Margin="0,8,0,3" />
                                <TextBox x:Name="VertexLabelEditor" />
                                <WrapPanel Margin="0,5">
                                    <Button x:Name="VertexLabelButton" Content="ラベルを設定" Click="SetVertexLabel_Click" Padding="5,3" />
                                    <Button x:Name="ClearVertexLabelButton" Content="消去" Click="ClearVertexLabel_Click" Padding="5,3" Margin="5,0" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="TimeSurface" Grid.Row="1" Grid.ColumnSpan="3"
                    Background="#25272B" BorderBrush="#41444A" BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PanelHeader}"
                               Text="{DynamicResource Panel.Timeline}" Width="112" />
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="◀" Width="32" Margin="2" IsEnabled="False" />
                            <Button Content="▶" Width="32" Margin="2" IsEnabled="False" />
                            <TextBlock Text="00:00:00:00" Foreground="#ECECEC"
                                       VerticalAlignment="Center" Margin="10,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,8,0,0" Background="#1D1F22"
                                BorderBrush="#4B4E54" BorderThickness="1">
                            <TextBlock Text="Animation surface foundation — authoringは次Phase"
                                       Foreground="#AEB0B5" Margin="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
