{
  "name": "flamoris-2d",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "desktop": "electron .",
    "desktop:pack": "node scripts/release-hygiene.mjs prepare && electron-builder --win --dir && node scripts/release-hygiene.mjs verify-electron",
    "desktop:dist": "node scripts/release-hygiene.mjs prepare && electron-builder --win nsis && node scripts/release-hygiene.mjs verify-electron",
    "product-host": "node product-host/main.mjs",
    "test:product-host": "node --test tests/product-host.test.js",
    "test": "node --check desktop/main.mjs && node --check desktop/preload.cjs && node --test tests/*.test.js"
  },
  "dependencies": {
    "ag-psd": "31.0.2"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "jp.flamoris.flamoris2d",
    "productName": "FLAMORIS 2D",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "node_modules/ag-psd/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "fl2d",
        "name": "FLAMORIS 2D Project",
        "description": "FLAMORIS 2D Project",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE-FLAMORIS.txt"
      },
      {
        "from": "dist/third-party-licenses",
        "to": "third-party-licenses"
      }
    ]
  },
  "license": "Apache-2.0"
}
